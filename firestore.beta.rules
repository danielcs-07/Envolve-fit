// SOMENTE VERSAO BETA MULTI-PERSONAL.
// Nao publicar no Firebase atual antes de concluir o isolamento e os testes.
// Em projeto beta novo, publique estas regras antes do primeiro cadastro.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function activeUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function isTrainer() {
      return activeUser()
        && get(userPath(request.auth.uid)).data.role == "trainer";
    }

    function isStudent() {
      return activeUser()
        && get(userPath(request.auth.uid)).data.role == "student";
    }

    function ownsStudent(studentId) {
      return isTrainer()
        && studentId is string
        && studentId.size() > 0
        && exists(userPath(studentId))
        && get(userPath(studentId)).data.role == "student"
        && get(userPath(studentId)).data.active == true
        && get(userPath(studentId)).data.trainerId == request.auth.uid;
    }

    function myTrainerId() {
      return get(userPath(request.auth.uid)).data.trainerId;
    }

    function validWorkout(data) {
      return data.trainerId == request.auth.uid
        && data.status in ["draft", "published"]
        && data.studentId is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 150
        && data.exercises is list
        && data.exercises.size() > 0
        && data.exercises.size() <= 100
        && (
          (data.status == "draft" && data.studentId == "")
          || ownsStudent(data.studentId)
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || (isTrainer() && resource.data.trainerId == request.auth.uid)
      );

      // Consultas com where("trainerId", "==", uid).
      allow list: if isTrainer()
        && resource.data.trainerId == request.auth.uid;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name", "email", "role", "active", "createdAt", "trainerId"
        ])
        && request.resource.data.keys().hasAll([
          "name", "email", "role", "active", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.role == "trainer"
            && !("trainerId" in request.resource.data)
          )
          || (
            request.resource.data.role == "student"
            && request.resource.data.keys().hasAll(["trainerId"])
            && request.resource.data.trainerId is string
            && exists(userPath(request.resource.data.trainerId))
            && get(userPath(request.resource.data.trainerId)).data.role == "trainer"
            && get(userPath(request.resource.data.trainerId)).data.active == true
          )
        );

      allow update: if isTrainer()
        && resource.data.role == "student"
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["active"])
        && request.resource.data.active is bool;

      allow delete: if false;
    }

    match /workouts/{workoutId} {
      allow read: if (
        isTrainer() && resource.data.trainerId == request.auth.uid
      ) || (
        isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == "published"
      );

      allow create: if isTrainer()
        && validWorkout(request.resource.data);

      allow update: if isTrainer()
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validWorkout(request.resource.data);

      allow delete: if isTrainer()
        && resource.data.trainerId == request.auth.uid;
    }

    match /trainingLogs/{logId} {
      allow read: if (
        isTrainer() && resource.data.trainerId == request.auth.uid
      ) || (
        isStudent() && resource.data.studentId == request.auth.uid
      );

      allow create: if isStudent()
        && request.resource.data.keys().hasOnly([
          "studentId", "trainerId", "workoutId",
          "workoutName", "exercises", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "studentId", "trainerId", "workoutId",
          "workoutName", "exercises", "createdAt"
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.trainerId == myTrainerId()
        && request.resource.data.workoutId is string
        && request.resource.data.workoutName is string
        && request.resource.data.workoutName.size() <= 250
        && request.resource.data.exercises is list
        && request.resource.data.exercises.size() > 0
        && request.resource.data.exercises.size() <= 100
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId))
        && get(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)).data.trainerId == myTrainerId()
        && get(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)).data.status == "published";

      allow update, delete: if false;
    }

    match /measurements/{measurementId} {
      allow read: if (
        isTrainer() && resource.data.trainerId == request.auth.uid
      ) || (
        isStudent() && resource.data.studentId == request.auth.uid
      );

      allow create: if isStudent()
        && request.resource.data.keys().hasOnly([
          "studentId", "trainerId", "weight", "height", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "studentId", "trainerId", "weight", "height", "createdAt"
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.trainerId == myTrainerId()
        && request.resource.data.weight is number
        && request.resource.data.weight >= 1
        && request.resource.data.weight <= 500
        && request.resource.data.height is number
        && request.resource.data.height >= 50
        && request.resource.data.height <= 250
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
